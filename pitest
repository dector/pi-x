#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
EXTENSIONS_DIR="$SCRIPT_DIR/extensions"

if ! command -v pi >/dev/null 2>&1; then
	echo "Error: 'pi' command not found in PATH" >&2
	exit 1
fi

if [[ ! -d "$EXTENSIONS_DIR" ]]; then
	echo "Error: extensions directory not found: $EXTENSIONS_DIR" >&2
	exit 1
fi

INCLUDE_ALL=0
WITH_NVIM=0
PI_ARGS=()
for arg in "$@"; do
	case "$arg" in
		--include-all)
			INCLUDE_ALL=1
			;;
		--nvim)
			WITH_NVIM=1
			;;
		*)
			PI_ARGS+=("$arg")
			;;
	esac
done

# Always load the entrypoint file, never the extension directory. Passing a
# directory that contains a prompts/ (or skills/, themes/) subdir makes Pi treat
# it as a resource package and skip the entrypoint, so its tools would never
# register. Loading the file explicitly also keeps it visible in Pi's verbose
# extension list. Conventional resources must then be passed separately.
add_extension() {
	local index_file="$1"
	local ext_dir
	ext_dir="$(dirname "$index_file")"

	EXT_ARGS+=("-e" "$index_file")
	[[ -d "$ext_dir/skills" ]] && EXT_ARGS+=("--skill" "$ext_dir/skills")
	[[ -d "$ext_dir/prompts" ]] && EXT_ARGS+=("--prompt-template" "$ext_dir/prompts")
	[[ -d "$ext_dir/themes" ]] && EXT_ARGS+=("--theme" "$ext_dir/themes")

	# The trailing `[[ ... ]] && ...` above can return non-zero; with `set -e`
	# that would abort the caller. Report success explicitly.
	return 0
}

EXT_ARGS=()

# Repo extensions: load tracked ones, or every one with --include-all.
while IFS= read -r -d '' index_file; do
	rel_index="${index_file#"$SCRIPT_DIR"/}"

	tracked=0
	git -C "$SCRIPT_DIR" ls-files --error-unmatch -- "$rel_index" >/dev/null 2>&1 && tracked=1

	if [[ $tracked -eq 1 || $INCLUDE_ALL -eq 1 ]]; then
		add_extension "$index_file"
	fi
done < <(find "$EXTENSIONS_DIR" -mindepth 2 -maxdepth 2 -type f -name "index.ts" -print0 | sort -z)

# Dev-only extensions under ./dev/extensions are always loaded by pitest.
DEV_EXTENSIONS_DIR="$SCRIPT_DIR/dev/extensions"
if [[ -d "$DEV_EXTENSIONS_DIR" ]]; then
	while IFS= read -r -d '' index_file; do
		add_extension "$index_file"
	done < <(find "$DEV_EXTENSIONS_DIR" -mindepth 2 -maxdepth 2 -type f -name "index.ts" -print0 | sort -z)
fi

if [[ ${#EXT_ARGS[@]} -eq 0 ]]; then
	echo "Error: no extensions found under $EXTENSIONS_DIR" >&2
	exit 1
fi

# `--no-extensions` below disables global extensions, including Herdr's managed
# Pi lifecycle integration. Load just that managed integration back when present
# so Herdr can see repo-extension prompts (for example safe-mode approvals) as
# blocked/waiting instead of working/in-progress.
HERDR_EXT_FILE="$HOME/.pi/agent/extensions/herdr-agent-state.ts"
# This repo forks Herdr's managed Pi integration. When the fork is present the
# find loop above already loaded it, so do not also load the managed copy (that
# would report the same pane twice).
HERDR_FORK_FILE="$SCRIPT_DIR/extensions/herdr-agent-state/index.ts"
if [[ "${PI_PITEST_HERDR_INTEGRATION:-true}" != "false" && -f "$HERDR_EXT_FILE" && ! -f "$HERDR_FORK_FILE" ]]; then
	EXT_ARGS+=("-e" "$HERDR_EXT_FILE")
fi

if [[ $WITH_NVIM -eq 1 ]]; then
	NVIM_EXT_DIR="$HOME/.pi/tmp/extensions/pi-nvim"
	if [[ -f "$NVIM_EXT_DIR/extension.ts" ]]; then
		EXT_ARGS+=("-e" "$NVIM_EXT_DIR/extension.ts")
	elif [[ -f "$NVIM_EXT_DIR/index.ts" ]]; then
		EXT_ARGS+=("-e" "$NVIM_EXT_DIR/index.ts")
	else
		echo "Warning: --nvim requested, but no extension entrypoint found in $NVIM_EXT_DIR (expected extension.ts or index.ts)." >&2
	fi
fi

# Keep pi's built-in documentation reference block visible during pitest runs by
# disabling the no-reflection extension unless the caller explicitly overrides it.
: "${PI_NO_REFLECTION:=false}"
export PI_NO_REFLECTION

exec pi --no-extensions "${EXT_ARGS[@]}" "${PI_ARGS[@]}"
