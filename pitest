#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
EXTENSIONS_DIR="$SCRIPT_DIR/extensions"

if ! command -v pi >/dev/null 2>&1; then
	echo "Error: 'pi' command not found in PATH" >&2
	exit 1
fi

if [[ ! -d "$EXTENSIONS_DIR" ]]; then
	echo "Error: extensions directory not found: $EXTENSIONS_DIR" >&2
	exit 1
fi

EXT_ARGS=()
while IFS= read -r -d '' index_file; do
	ext_dir="$(dirname "$index_file")"
	EXT_ARGS+=("-e" "$ext_dir")
done < <(find "$EXTENSIONS_DIR" -mindepth 2 -maxdepth 2 -type f -name "index.ts" -print0 | sort -z)

if [[ ${#EXT_ARGS[@]} -eq 0 ]]; then
	echo "Error: no extensions found under $EXTENSIONS_DIR" >&2
	exit 1
fi

WITH_NVIM=0
PI_ARGS=()
for arg in "$@"; do
	if [[ "$arg" == "--nvim" ]]; then
		WITH_NVIM=1
		continue
	fi
	PI_ARGS+=("$arg")
done

if [[ $WITH_NVIM -eq 1 ]]; then
	NVIM_EXT_DIR="$HOME/.pi/tmp/extensions/pi-nvim"
	if [[ -f "$NVIM_EXT_DIR/extension.ts" ]]; then
		EXT_ARGS+=("-e" "$NVIM_EXT_DIR/extension.ts")
	elif [[ -f "$NVIM_EXT_DIR/index.ts" ]]; then
		EXT_ARGS+=("-e" "$NVIM_EXT_DIR/index.ts")
	else
		echo "Warning: --nvim requested, but no extension entrypoint found in $NVIM_EXT_DIR (expected extension.ts or index.ts)." >&2
	fi
fi

# Keep pi's built-in documentation reference block visible during pitest runs by
# disabling the no-reflection extension unless the caller explicitly overrides it.
: "${PI_NO_REFLECTION:=false}"
export PI_NO_REFLECTION

exec pi --no-extensions "${EXT_ARGS[@]}" "${PI_ARGS[@]}"
