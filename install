#!/usr/bin/env bash
set -euo pipefail

# Installs extensions from this repo onto the current machine using rsync.
# Default target: ~/.pi/agent/extensions
# Override with: PI_EXTENSIONS_DIR=/some/path ./install

# Color only terminal output; respect NO_COLOR and dumb terminals.
BOLD='' CYAN='' GREEN='' YELLOW='' DIM='' RESET=''
if [[ -t 1 && -z "${NO_COLOR+x}" && "${TERM:-dumb}" != dumb ]]; then
  BOLD=$'\033[1m' CYAN=$'\033[36m' GREEN=$'\033[32m'
  YELLOW=$'\033[33m' DIM=$'\033[2m' RESET=$'\033[0m'
fi

message() {
  printf '%s%s%s %s\n' "$1" "$2" "$RESET" "$3"
}

section() {
  printf '\n'
  message "$BOLD$CYAN" '==' "$1"
}

usage() {
  cat <<'EOF'
Usage: ./install [--skip-herdr | --replace-herdr]

This installer always requires interactive confirmation.

This repo forks Herdr's managed Pi integration (herdr-agent-state). If the
installed ~/.pi/agent/extensions/herdr-agent-state.ts does not match the
upstream revision this fork was based on, install aborts before touching any
file. Choose one:

  --skip-herdr     keep the official integration, do not install the fork
  --replace-herdr  overwrite the official integration with the fork anyway
EOF
}

SKIP_HERDR=0
REPLACE_HERDR=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    --skip-herdr)
      SKIP_HERDR=1
      ;;
    --replace-herdr)
      REPLACE_HERDR=1
      ;;
    *)
      echo "Error: unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
  shift
done

if [[ $SKIP_HERDR -eq 1 && $REPLACE_HERDR -eq 1 ]]; then
  echo "Error: --skip-herdr and --replace-herdr are mutually exclusive." >&2
  exit 1
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SRC_ROOT="$SCRIPT_DIR/extensions"
DEST_ROOT="${PI_EXTENSIONS_DIR:-$HOME/.pi/agent/extensions}"
THEMES_SRC="$SCRIPT_DIR/themes"
THEMES_DEST="${PI_THEMES_DIR:-$HOME/.pi/agent/themes}"

# Herdr's managed Pi integration is a single file here and this repo ships a
# fork of it. We install the fork AT that path, so Herdr still sees the
# integration as installed. Replacing an unknown revision could drop fixes, so
# only auto-replace the exact upstream file the fork was based on (or our own
# fork, recognized by its marker). This check runs before any file operation.
HERDR_FLAT_EXT="$DEST_ROOT/herdr-agent-state.ts"
HERDR_FORK_MARKER="FORK of the official Herdr Pi integration"
# sha256 of herdrdev/herdr src/integration/assets/pi/herdr-agent-state.ts v9 (0.9.1).
HERDR_UPSTREAM_SHA256="2c5272d732b475bbf91a027203b1f98d25fe43d2c1402530a442b288aeaca1e4"

file_sha256() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
  else
    shasum -a 256 "$1" | awk '{print $1}'
  fi
}

if [[ $SKIP_HERDR -eq 0 && -f "$HERDR_FLAT_EXT" ]]; then
  herdr_actual_sha256="$(file_sha256 "$HERDR_FLAT_EXT")"
  herdr_is_fork=0
  grep -qF "$HERDR_FORK_MARKER" "$HERDR_FLAT_EXT" 2>/dev/null && herdr_is_fork=1
  if [[ $herdr_is_fork -eq 0 && "$herdr_actual_sha256" != "$HERDR_UPSTREAM_SHA256" && $REPLACE_HERDR -eq 0 ]]; then
    {
      echo "Error: the installed Herdr integration does not match this fork's upstream."
      echo
      echo "  file:     $HERDR_FLAT_EXT"
      echo "  expected: $HERDR_UPSTREAM_SHA256  (herdr pi v9 / 0.9.1)"
      echo "  actual:   $herdr_actual_sha256"
      echo
      echo "Herdr likely shipped a newer integration. Rebase the fork first"
      echo "(see extensions/herdr-agent-state/README.md), or rerun with:"
      echo
      echo "  ./install --skip-herdr     keep the official integration, skip the fork"
      echo "  ./install --replace-herdr  overwrite it with this fork anyway"
    } >&2
    exit 1
  fi
fi

if [[ ! -d "$SRC_ROOT" ]]; then
  echo "Error: source extensions directory not found: $SRC_ROOT" >&2
  exit 1
fi

PKG_MGR=""
PKG_INSTALL_CMD=()

if command -v bun >/dev/null 2>&1; then
  PKG_MGR="bun"
  PKG_INSTALL_CMD=(bun install)
elif command -v pnpm >/dev/null 2>&1; then
  PKG_MGR="pnpm"
  PKG_INSTALL_CMD=(pnpm install)
elif command -v npm >/dev/null 2>&1; then
  PKG_MGR="npm"
  PKG_INSTALL_CMD=(npm install)
else
  echo "Error: no package manager found in PATH." >&2
  echo "Install one of: bun (preferred), pnpm, npm" >&2
  exit 1
fi

section 'Pi extension installer'
printf '  Extensions:      %s\n  Themes:          %s\n  Package manager: %s\n' "$DEST_ROOT" "$THEMES_DEST" "$PKG_MGR"
printf '\n'
message "$YELLOW" 'Warning:' 'rsync uses --delete and may remove files under each extension target.'

if [[ ! -t 0 ]]; then
  echo "Error: confirmation required but no interactive stdin detected." >&2
  echo "Run ./install from an interactive terminal session." >&2
  exit 1
fi

read -r -p "Continue and sync into this directory? [y/N] " confirm
if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
  echo "Aborted."
  exit 1
fi

mkdir -p "$DEST_ROOT"

# Install neo-bar first because other extensions depend on it.
extensions=(
  "hub"
  "neo-bar"
  "panels"
  "subagent"
  "proc"
  "no-reflection"
  "switch-thinking"
  "review-level"
  "safe-mode"
  "permissions-core"
  "permissions-ui"
  "renew"
  "flutter"
  "http"
  "interactive-bash"
  "pi-ui"
  "hide-tools"
  "sqlite"
  "save"
  "prompt-stash"
  "notes"
  "pi-nvim"
  "tunnel"
  "focus-mode"
  "vim-mode"
  "model-presets"
  "gust"
  "herdr-agent-state"
)

# Report source extensions omitted by the whitelist, not extensions skipped
# explicitly with --skip-herdr or missing whitelist entries.
excluded_extensions=()
for ext_dir in "$SRC_ROOT"/*/; do
  ext="${ext_dir%/}"
  ext="${ext##*/}"
  whitelisted=0
  for allowed in "${extensions[@]}"; do
    if [[ "$ext" == "$allowed" ]]; then
      whitelisted=1
      break
    fi
  done
  if [[ $whitelisted -eq 0 ]]; then
    excluded_extensions+=("$ext")
  fi
done

if [[ $SKIP_HERDR -eq 1 ]]; then
  extensions_without_herdr=()
  for ext in "${extensions[@]}"; do
    [[ "$ext" == "herdr-agent-state" ]] && continue
    extensions_without_herdr+=("$ext")
  done
  extensions=("${extensions_without_herdr[@]}")
fi

dependency_extensions=()
lockfiles=(bun.lock bun.lockb package-lock.json npm-shrinkwrap.json pnpm-lock.yaml yarn.lock)

section '1/4 · Sync extensions'
printf '  Target: %s\n' "$DEST_ROOT"
for ext in "${extensions[@]}"; do
  src="$SRC_ROOT/$ext/"
  dest="$DEST_ROOT/$ext/"

  if [[ ! -d "$src" ]]; then
    message "$YELLOW" '[skip]' "Skipping missing extension: $ext"
    continue
  fi

  if [[ "$ext" == "herdr-agent-state" ]]; then
    # Install as Herdr's managed flat file so `herdr integration status` still
    # sees the integration as installed. The fork keeps the ID/version markers.
    if [[ ! -e "$dest" ]] && cmp -s "$src/index.ts" "$HERDR_FLAT_EXT"; then
      message "$DIM" '[same]' "$ext: unchanged"
      continue
    fi
    rm -rf "$dest"
    cp "$src/index.ts" "$HERDR_FLAT_EXT"
    message "$GREEN" '[sync]' "$ext -> $HERDR_FLAT_EXT"
    continue
  fi

  # Package managers create local dependencies and sometimes a new lockfile.
  # Keep those out of the comparison and sync unless a lockfile is supplied
  # by the source. Normal excludes also protect these files from --delete.
  sync_options=(-a --no-times --checksum --delete --exclude=node_modules/ --exclude=/.pi-x-install-pending)
  for lockfile in "${lockfiles[@]}"; do
    if [[ ! -e "$src$lockfile" ]]; then
      sync_options+=("--exclude=/$lockfile")
    fi
  done

  needs_dependencies=0
  if [[ -f "$src/package.json" ]]; then
    if [[ -f "${dest}.pi-x-install-pending" || ! -d "${dest}node_modules" ]] || ! cmp -s "$src/package.json" "${dest}package.json"; then
      needs_dependencies=1
    fi
    for lockfile in "${lockfiles[@]}"; do
      if [[ -f "$src$lockfile" ]] && ! cmp -s "$src$lockfile" "$dest$lockfile"; then
        needs_dependencies=1
      fi
    done
  fi

  # Persist pending work before syncing manifests so a failed install is retried.
  if [[ $needs_dependencies -eq 1 ]]; then
    mkdir -p "$dest"
    touch "${dest}.pi-x-install-pending"
  fi

  changes="$(rsync "${sync_options[@]}" --dry-run --itemize-changes "$src" "$dest")"
  if [[ -n "$changes" ]]; then
    message "$CYAN" '[sync]' "$ext: syncing changes"
    rsync "${sync_options[@]}" "$src" "$dest"
  else
    message "$DIM" '[same]' "$ext: unchanged"
  fi

  if [[ $needs_dependencies -eq 1 ]]; then
    dependency_extensions+=("$ext")
  fi
done

# `reset` was renamed to `renew`. Remove a stale installed copy so the old
# `/reset` command and `px:reset:*` handlers cannot linger beside the new one.
if [[ -d "$DEST_ROOT/reset" ]]; then
  rm -rf "$DEST_ROOT/reset"
  message "$YELLOW" '[clean]' 'removed legacy reset/ (renamed to renew/)'
fi

section '2/4 · Install dependencies'
if [[ ${#dependency_extensions[@]} -eq 0 ]]; then
  message "$DIM" '[same]' 'Dependencies are up to date.'
else
  printf '  %s extension(s) need dependencies (%s).\n' "${#dependency_extensions[@]}" "$PKG_MGR"
fi
for ext in "${dependency_extensions[@]}"; do
  ext_dir="$DEST_ROOT/$ext"

  if [[ ! -d "$ext_dir" ]]; then
    echo "Skipping missing destination directory: $ext_dir"
    continue
  fi

  if [[ ! -f "$ext_dir/package.json" ]]; then
    echo "- $ext: skipping dependency install (no package.json)"
    continue
  fi

  message "$CYAN" '[deps]' "$ext: ${PKG_INSTALL_CMD[*]}"
  (
    cd "$ext_dir"
    "${PKG_INSTALL_CMD[@]}"
  )
  rm -f "$ext_dir/.pi-x-install-pending"
done

section '3/4 · Sync themes'
if [[ -d "$THEMES_SRC" ]]; then
  message "$CYAN" '[sync]' "Syncing themes into: $THEMES_DEST"
  mkdir -p "$THEMES_DEST"
  # No --delete: keep user themes that this repo does not manage.
  rsync -a --checksum "$THEMES_SRC"/ "$THEMES_DEST"/
else
  echo "No themes directory found, skipping themes."
fi

# Some extensions ship agent definitions and prompt templates in their own
# subdirectories. Pi loads those from top-level ~/.pi/agent/{agents,prompts},
# not from the extension directory, so copy them out explicitly.
AGENTS_DEST="${PI_AGENTS_DIR:-$HOME/.pi/agent/agents}"
PROMPTS_DEST="${PI_PROMPTS_DIR:-$HOME/.pi/agent/prompts}"

section '4/4 · Sync agents and prompts'
has_agents=0
has_prompts=0
for ext_dir in "$SRC_ROOT"/*/; do
  if [[ -d "$ext_dir/agents" ]]; then
    has_agents=1
  fi
  if [[ -d "$ext_dir/prompts" ]]; then
    has_prompts=1
  fi
done

if [[ $has_agents -eq 1 ]]; then
  message "$CYAN" '[sync]' "Syncing agent definitions into: $AGENTS_DEST"
  mkdir -p "$AGENTS_DEST"
  for ext_dir in "$SRC_ROOT"/*/; do
    if [[ -d "$ext_dir/agents" ]]; then
      # No --delete: keep user agents that this repo does not manage.
      rsync -a --checksum "$ext_dir/agents"/ "$AGENTS_DEST"/
    fi
  done
else
  echo "No extension agent directories found, skipping agents."
fi

if [[ $has_prompts -eq 1 ]]; then
  message "$CYAN" '[sync]' "Syncing prompt templates into: $PROMPTS_DEST"
  mkdir -p "$PROMPTS_DEST"
  for ext_dir in "$SRC_ROOT"/*/; do
    if [[ -d "$ext_dir/prompts" ]]; then
      # No --delete: keep user prompts that this repo does not manage.
      rsync -a --checksum "$ext_dir/prompts"/ "$PROMPTS_DEST"/
    fi
  done
else
  echo "No extension prompt directories found, skipping prompts."
fi

printf '\n'
message "$BOLD$GREEN" '[done]' 'Install complete. Reload pi to apply updates (/reload).'
if [[ ${#excluded_extensions[@]} -gt 0 ]]; then
  printf '\n'
  message "$DIM" '[skip]' 'Extensions not installed (not in whitelist):'
  printf '  - %s\n' "${excluded_extensions[@]}"
fi
